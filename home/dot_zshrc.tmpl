#============== OMZ CORE CONFIG ==============
export ZSH="$HOME/.config/oh-my-zsh"

ZSH_THEME=""
# Keep the completion dump in the cache directory.
# Oh My Zsh issue #13406 tracks using ZSH_CACHE_DIR for zcompdump by default;
# currently, it instead writes the dump directly under $HOME.
# Set these before Oh My Zsh reads them while initializing compinit.
# https://github.com/ohmyzsh/ohmyzsh/issues/13406
export ZSH_CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/oh-my-zsh"
export ZSH_COMPDUMP="$ZSH_CACHE_DIR/.zcompdump-${ZSH_VERSION}"

plugins=(
    starship
    ssh-agent
    gpg-agent
    mise
    zoxide
    zsh-autosuggestions
    zsh-syntax-highlighting
    zsh-autocomplete
    # Loads fzf's Zsh integration through Oh My Zsh:
    # - Enables fuzzy **<Tab> completion.
    # - Registers ZLE (Zsh’s command-line editor) widgets for file, directory, and command-history searches.
    # - Provides Ctrl+T, Alt+C, and Ctrl+R bindings by default.
    # - Ctrl+T and Alt+C are rebound to Ctrl+F and Ctrl+S below.
    fzf
)


source "$ZSH/oh-my-zsh.sh"


#============== VARIABLES ==============

{{ if .isWork -}}
export _REPOS="$HOME/atlassian/repos"
export _WORKTREES="$HOME/atlassian/worktrees"
{{ else -}}
export _REPOS="$HOME/dev/repos"
export _WORKTREES="$HOME/dev/worktrees"
{{ end }}

#============== ZSH VI MODE ==============

export EDITOR=nvim
export VISUAL=nvim
autoload -Uz edit-command-line
zle -N edit-command-line

# Bind F2 to open the command line in Vim
bindkey '^[OQ' edit-command-line
bindkey '^[[12~' edit-command-line


#============== ZSH-AUTOCOMPLETE PLUGIN ==============

# Make Tab and ShiftTab go to the menu
bindkey              '^I' menu-select
bindkey "$terminfo[kcbt]" menu-select
# Make Tab and ShiftTab change the selection in the menu
bindkey -M menuselect              '^I'         menu-complete
bindkey -M menuselect "$terminfo[kcbt]" reverse-menu-complete

# Disable zsh-autocomplete expansion section
# https://github.com/marlonrichert/zsh-autocomplete/issues/759
zstyle ':completion:*' \
	completer  \
	_complete _complete:-fuzzy _correct _approximate _ignored

# Make hidden files (starting with '.') show without explicit specification for autocomplete
# GLOBDOTS lets files beginning with a . be matched without explicitly specifying the dot.
# https://zsh.sourceforge.io/Intro/intro_16.html
# https://unix.stackexchange.com/questions/308315/how-can-i-configure-zsh-completion-to-show-hidden-files-and-folders
setopt globdots

#============== FZF ==============

export FZF_DEFAULT_OPTS=$'--highlight-line
  --bind tab:toggle
  --color=fg:#cad3f5,bg:#24273a,hl:#ed8796,fg+:#cad3f5,bg+:#363a4f
  --color=hl+:#ed8796,info:#c6a0f6,prompt:#c6a0f6,pointer:#f4dbd6
  --color=marker:#f7e6e2,spinner:#f4dbd6,header:#ed8796,border:#5b6078
  --color=gutter:#363a4f'

# Widgets come from the OMZ fzf plugin (`fzf --zsh`), which binds them to Ctrl+T / Alt+C / Ctrl+R.
# Ctrl+T and Alt+C are moved:
#   Ctrl+F (formerly Ctrl+T) - pick files/dirs below the current dir; Enter pastes the path(s) into the command line
#   Ctrl+S (formerly Alt+C) - pick a dir below the current dir; Enter cd's into it
#   Ctrl+R - pick a command from history; Enter puts it on the command line
# Avoid keys that start other bindings (e.g. Ctrl+X, the prefix of Ctrl+X Ctrl+E): zsh would wait
# KEYTIMEOUT (0.4s) for a second key before opening the picker.
# Ctrl+S reaches zsh because flow control is off; it replaces zsh-autocomplete's history search.

for keymap in emacs viins vicmd; do
  bindkey -M "$keymap" -r '^T' '^[c'
  bindkey -M "$keymap" '^F' fzf-file-widget
  bindkey -M "$keymap" '^S' fzf-cd-widget
done
unset keymap

# Without these settings Ctrl+T/Alt+C use fzf's built-in walker, which ignores .gitignore
# (lists every target/, dist/, ...), and show no preview.
# fd respects .gitignore; --hidden keeps dotfiles like .github/, so .git is excluded explicitly.
# fd does not descend into excluded directories. Maintain each picker's exclusions separately.

FZF_CTRL_T_EXCLUDE_DIRS=(.git)
FZF_ALT_C_EXCLUDE_DIRS=(.git target src funct-tests)

FZF_CTRL_T_EXCLUDE_ARGS=()
for dir in "${FZF_CTRL_T_EXCLUDE_DIRS[@]}"; do
  FZF_CTRL_T_EXCLUDE_ARGS+=(--exclude "$dir")
done

FZF_ALT_C_EXCLUDE_ARGS=()
for dir in "${FZF_ALT_C_EXCLUDE_DIRS[@]}"; do
  FZF_ALT_C_EXCLUDE_ARGS+=(--exclude "$dir")
done
unset dir

export FZF_CTRL_T_COMMAND="fd --hidden --follow --max-depth 4 ${FZF_CTRL_T_EXCLUDE_ARGS[*]}"
export FZF_ALT_C_COMMAND="fd --type d --hidden --follow --max-depth 4 ${FZF_ALT_C_EXCLUDE_ARGS[*]}"

# Preview pane: eza shows dirs as a tree, bat shows file contents (bat can't render dirs).

export FZF_CTRL_T_OPTS="--preview '[[ -d {} ]] && eza --tree --level=2 --color=always {} || bat --style=numbers --color=always --line-range=:300 {}'"
export FZF_ALT_C_OPTS="--preview 'eza --tree --level=2 --color=always {}'"

#============== ZOXIDE ==============

export _ZO_EXCLUDE_DIRS="$HOME:$_REPOS/dc/crowd:$_REPOS/dc/jira:$_REPOS/dc/confluence"

#============== ALIASES ==============

alias vim='nvim'
alias g='git'
alias gp='git push'

#============== UTILITY COMMANDS ==============

# fuzzy-pick a Git repository under $_REPOS and change into it
crepo() {
  local repo git_metadata

  repo=$(
    fd --hidden --no-ignore --glob '.git' --prune --max-depth 5 --search-path "$_REPOS" |
      while IFS= read -r git_metadata; do
        print -r -- "${${git_metadata:h}#"$_REPOS"/}"
      done |
      fzf --height "${FZF_TMUX_HEIGHT:-40%}" \
        --min-height '20+' \
        --reverse \
        --prompt='Repository> ' \
        --preview 'git -C "$_REPOS"/{} status --short --branch'
  )

  [[ -n "$repo" ]] && cd -- "$_REPOS/$repo"
}

# Open the repository picker with Ctrl+Q.
crepo-widget() {
  crepo
  zle reset-prompt
}
zle -N crepo-widget

for keymap in emacs viins vicmd; do
  bindkey -M "$keymap" '^Q' crepo-widget
done
unset keymap

# fuzzy-pick a branch and check it out
gco() {
  git branch |
    fzf --header='Pick branch to checkout' |
    cut -c 3- |
    xargs git checkout
}

# fuzzy-pick (multi-select with tab) one or more branches and force-delete them
grb() {
  git branch |
    fzf -m --header='Select local branch(es) to delete' |
    cut -c 3- |
    xargs -I {} git branch -D {}
}

# fuzzy-pick a branch and copy its name to the clipboard (newline stripped)
gcb() {
  git branch |
    fzf --header='Pick branch to copy to clipboard' |
    cut -c 3- |
    tr -d "\n" |
    pbcopy
}

#============== GIT WORKTREES ==============

# create a worktree on a new branch and cd into it: prompts for the branch name
# (or takes it as $1), fuzzy-picks the base branch, places it in $_WORKTREES/<repo>-<random hex>
gwa() {
  local common_dir repo_root branch base target

  common_dir=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || {
    print -u2 'gwa: not inside a Git repository'
    return 1
  }
  repo_root=${common_dir:h}

  branch=$1
  [[ -n "$branch" ]] || read -r 'branch?New branch name: '
  [[ -n "$branch" ]] || return 1
  if ! git check-ref-format --branch "$branch" >/dev/null 2>&1; then
    print -u2 "gwa: invalid branch name: $branch"
    return 1
  fi
  if git -C "$repo_root" show-ref --verify --quiet "refs/heads/$branch"; then
    print -u2 "gwa: branch already exists: $branch"
    return 1
  fi

  # order: main/master, then release/* (newest version first), then the rest (newest commit first);
  # local and remote copies of a branch are grouped by name without the remote prefix.
  # symrefs (origin/HEAD) print as lines without a refname and are dropped by awk
  base=$(
    git -C "$repo_root" for-each-ref --sort=-committerdate --color=always \
      --format='%(if)%(symref)%(then)%(else)%(refname)%09%(refname:short)%09%(color:green)%(committerdate:relative)%(end)' \
      refs/heads refs/remotes |
      awk -F'\t' -v OFS='\t' '$1 ~ /^refs\// {
        name = $1
        sub(/^refs\/heads\//, "", name)
        sub(/^refs\/remotes\/[^\/]+\//, "", name)
        if (name ~ /^(main|master)$/) print 0, "", $2, $3
        else if (name ~ /^release\//) print 1, name, $2, $3
        else print 2, "", $2, $3
      }' |
      sort -s -t$'\t' -k1,1n -k2,2Vr |
      cut -f3- |
      fzf --height "${FZF_TMUX_HEIGHT:-40%}" \
        --min-height '20+' \
        --reverse \
        --ansi \
        --tiebreak=index \
        --delimiter='\t' \
        --prompt='Base branch> ' \
        --header="New branch: $branch" \
        --preview "git -C ${(q)repo_root} log --oneline --graph --color=always -30 {1}"
  )
  base=${base%%$'\t'*}
  [[ -n "$base" ]] || return 1

  mkdir -p -- "$_WORKTREES" || return 1
  target="$_WORKTREES/${repo_root:t}-$(openssl rand -hex 3)"
  while [[ -e "$target" ]]; do target="$_WORKTREES/${repo_root:t}-$(openssl rand -hex 3)"; done

  # --no-track: don't make the new branch track its base (e.g. origin/master);
  # push.autoSetupRemote sets the upstream to origin/<branch> on first push
  git -C "$repo_root" worktree add --no-track -b "$branch" "$target" "$base" || return
  cd -- "$target"
}

# fuzzy-pick (multi-select with tab) worktrees under $_WORKTREES, remove them,
# then optionally force-delete their branches
gwr() {
  local -a selected branches
  local line wt branch repo_root entry prev_pwd

  selected=(${(f)"$(
    for wt in "$_WORKTREES"/*(N/); do
      print -r -- "${wt:t}"$'\t'"$(git -C "$wt" branch --show-current 2>/dev/null)"
    done |
      fzf --multi \
        --height "${FZF_TMUX_HEIGHT:-40%}" \
        --min-height '20+' \
        --reverse \
        --delimiter='\t' \
        --prompt='Remove worktree> ' \
        --header='Tab to select multiple' \
        --preview 'git -C "$_WORKTREES"/{1} status --short --branch; echo; git -C "$_WORKTREES"/{1} log --oneline --color=always -15'
  )"})
  (( ${#selected} )) || return 0

  for line in "${selected[@]}"; do
    wt="$_WORKTREES/${line%%$'\t'*}"
    branch=${line#*$'\t'}

    if ! repo_root=$(git -C "$wt" rev-parse --path-format=absolute --git-common-dir 2>/dev/null); then
      print "✗ Skipped: ${wt:t} (not a Git worktree; its repository may be gone)"
      continue
    fi
    repo_root=${repo_root:h}

    prev_pwd=$PWD
    [[ "$PWD" == "$wt" || "$PWD" == "$wt"/* ]] && cd -- "$repo_root"

    if git -C "$repo_root" worktree remove "$wt"; then
      print "✓ Removed: ${wt:t}"
      [[ -n "$branch" ]] && branches+=("$repo_root"$'\t'"$branch")
    else
      print "✗ Kept: ${wt:t} (use 'git worktree remove --force' to discard its changes)"
      cd -- "$prev_pwd"
    fi
  done
  (( ${#branches} )) || return 0

  print "Branches: ${(j:, :)${branches[@]#*$'\t'}}"
  if ! read -q '?Delete these branches too? [y/N] '; then
    print
    return 0
  fi
  print
  for entry in "${branches[@]}"; do
    git -C "${entry%%$'\t'*}" branch -D "${entry#*$'\t'}"
  done
}

# fuzzy-pick mise tools and uninstall
mrt() {
  local selected

  selected=$(
    mise ls --installed | \
      awk '{print $1"@"$2}' | \
      fzf --multi \
        --header="Pick mise tools to remove " \
  )

  [[ -z "$selected" ]] && return 0

  echo "$selected" | while read -r tool; do
    if mise uninstall "$tool"; then
      echo "✓ Uninstalled: $tool"
    else
      echo "✗ Failed: $tool"
    fi
  done
}

