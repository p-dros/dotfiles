{
  "workbench.iconTheme": "catppuccin-mocha",
  "workbench.sideBar.location": "right",
  "workbench.editor.editorActionsLocation": "hidden",
  "workbench.editor.centeredLayoutFixedWidth": true,
  "workbench.editorAssociations": {
    // Explcitily set default editor for git-rebase-todo as gitlens overrides it
    "git-rebase-todo": "default"
  },
  // Window / Security
  "window.nativeTabs": true,
  "security.promptForLocalFileProtocolHandling": false,
  "security.workspace.trust.enabled": true,
  "security.workspace.trust.untrustedFiles": "open",
  // Cursor
  "cursor.general.globalCursorIgnoreList": [
    "**/.env",
    "**/.env.*",
    "**/credentials.json",
    "**/secrets.json",
    "**/*.pem",
    "**/id_rsa"
  ],
  // Explorer / Files
  "explorer.confirmDelete": false,
  "explorer.confirmDragAndDrop": false,
  "files.associations": {
    "*.css": "tailwindcss",
    "*.prisma": "prisma"
  },
  // Search
  "search.exclude": {
    "**/dist": true
  },
  // Editor
  "editor.accessibilitySupport": "off",
  "editor.defaultFormatter": "oxc.oxc-vscode",
  "editor.fontFamily": "'JetBrainsMono Nerd Font Mono', 'JetBrains Mono', Menlo, Monaco, 'Courier New', monospace",
  "editor.lineNumbers": "relative",
  // Terminal
  "terminal.integrated.fontSize": 14,
  "terminal.integrated.scrollback": 15000,
  // Language behavior
  "javascript.updateImportsOnFileMove.enabled": "always",
  "typescript.updateImportsOnFileMove.enabled": "always",
  "java.dependency.autoRefresh": false,
  "java.autobuild.enabled": false,
  // Language-specific formatters
  "[java]": {
    "editor.defaultFormatter": "redhat.java"
  },
  "[css]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[jsonc]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[prisma]": {
    "editor.defaultFormatter": "Prisma.prisma"
  },
  "[shellscript]": {
    "editor.defaultFormatter": "foxundermoon.shell-format"
  },
  "[toml]": {
    "editor.defaultFormatter": "tamasfe.even-better-toml"
  },
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[xml]": {
    "editor.defaultFormatter": "redhat.vscode-xml"
  },
  // Extensions
  "gitlens.remotes": [
    {
      "regex": "ssh:\\/\\/(git@stash\\.atlassian\\.com):7997\\/(.+?)(?:\\.git)?$",
      "type": "BitbucketServer",
      "protocol": "https",
      "domain": "https://stash.atlassian.com",
      "username": "pdros"
    }
  ],
  "gitlens.hovers.avatars": false,
  "gitlens.partners": {
    "liveshare": { "enabled": false }
  },
  "gitlens.currentLine.format": "${author, }${agoOrDate}${' via 'pullRequest}${ • message|50?}",
  "gitlens.hovers.detailsMarkdownFormat": "__${author}__${signature} &nbsp;$(history) ${authorDate}${' via  'pullRequest} ${message}\n\n${commands}",
  "gitlens.mode.statusBar.enabled": false,
  // The ${commands} row in the hover is hardcoded, so each unwanted link can only be
  // removed by disabling the feature behind it: ai.enabled drops Explain,
  // hovers.pullRequests the PR link, integrations the Connect prompt,
  // plusFeatures the Commit Graph icon.
  "gitlens.ai.enabled": false,
  "gitlens.hovers.pullRequests.enabled": false,
  "gitlens.integrations.enabled": false,
  "gitlens.plusFeatures.enabled": false,
  "vim.easymotion": true,
  "vim.hlsearch": true,
  "vim.incsearch": true,
  "vim.leader": "<space>",
  "vim.smartRelativeLine": true,
  "vim.useCtrlKeys": true,
  "vim.useSystemClipboard": true,
  "mise.binPath": "/opt/homebrew/bin/mise",
  "prettier.printWidth": 120,
  // Misc
  "diffEditor.ignoreTrimWhitespace": false,
  "git.openRepositoryInParentFolders": "always",
  "explorer.confirmPasteNative": false,
  "window.autoDetectColorScheme": false,
  "python.defaultInterpreterPath": "/opt/homebrew/bin/python3",
}